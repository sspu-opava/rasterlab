{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RasterLab",
  "version": "0.4.0",
  "identifier": "cz.rasterlab.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RasterLab 0.4", "width": 1440, "height": 960, "minWidth": 1024, "minHeight": 700, "backgroundColor": "#171b20", "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
